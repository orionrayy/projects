{
 "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://orionrayy.github.io/projects/ffmpeg-motion-studio/foundation-v0-1/schemas/keyframe-clip.schema.json",
 "title":"Motion Studio keyframe clip","type":"object","additionalProperties":false,
 "required":["schema_version","clip_id","title","description","canvas","render_settings","source","rig","quality_contract","keyframes"],
 "properties":{
  "schema_version":{"const":"1.0.0"},"clip_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]+$"},"title":{"type":"string","minLength":1},"description":{"type":"string","minLength":1},
  "canvas":{"type":"object","additionalProperties":false,"required":["width","height","background"],"properties":{"width":{"type":"integer","minimum":1},"height":{"type":"integer","minimum":1},"background":{"$ref":"#/$defs/color"}}},
  "render_settings":{"type":"object","additionalProperties":false,"required":["fps","subdivisions_per_interval","interpolation","ink","stroke_width","joint_radius","head_radius"],"properties":{"fps":{"type":"integer","minimum":1,"maximum":120},"subdivisions_per_interval":{"type":"integer","minimum":1,"maximum":120},"interpolation":{"const":"linear"},"ink":{"$ref":"#/$defs/color"},"stroke_width":{"type":"number","exclusiveMinimum":0},"joint_radius":{"type":"number","exclusiveMinimum":0},"head_radius":{"type":"number","exclusiveMinimum":0}}},
  "source":{"type":"object","additionalProperties":false,"required":["uploaded_file","sha256","container_format","entry","source_application_project_name","scene_version_code","observed_interframes_attribute","source_frame_rate","source_frame_rate_status","interpolation_status","coordinate_interpretation","derived_thumbnail_colors"],"properties":{"uploaded_file":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"container_format":{"const":"ZIP"},"entry":{"const":"model.xml"},"source_application_project_name":{"type":"string"},"scene_version_code":{"type":"integer"},"observed_interframes_attribute":{"type":"integer","minimum":0},"source_frame_rate":{"type":["number","null"]},"source_frame_rate_status":{"type":"string"},"interpolation_status":{"type":"string"},"coordinate_interpretation":{"type":"string"},"derived_thumbnail_colors":{"type":"object","additionalProperties":false,"required":["background_estimate","ink_estimate","note"],"properties":{"background_estimate":{"$ref":"#/$defs/color"},"ink_estimate":{"$ref":"#/$defs/color"},"note":{"type":"string"}}}}},
  "rig":{"type":"object","additionalProperties":false,"required":["unit_name","landmark_order","point_id_by_landmark","parent_by_landmark","root_landmark","head_landmark","planted_candidate_landmark","swing_candidate_landmark"],"properties":{"unit_name":{"type":"string"},"landmark_order":{"type":"array","minItems":1,"items":{"type":"string"},"uniqueItems":true},"point_id_by_landmark":{"type":"object","additionalProperties":{"type":"integer","minimum":1}},"parent_by_landmark":{"type":"object","additionalProperties":{"type":["string","null"]}},"root_landmark":{"type":"string"},"head_landmark":{"type":"string"},"planted_candidate_landmark":{"type":"string"},"swing_candidate_landmark":{"type":"string"}}},
  "quality_contract":{"type":"object","additionalProperties":false,"required":["max_parent_segment_length_variation_px","root_expected_horizontal_direction","min_root_net_displacement_px","max_planted_candidate_net_displacement_px","min_swing_candidate_net_displacement_px","note"],"properties":{"max_parent_segment_length_variation_px":{"type":"number","minimum":0},"root_expected_horizontal_direction":{"enum":["left","right","either","none"]},"min_root_net_displacement_px":{"type":"number","minimum":0},"max_planted_candidate_net_displacement_px":{"type":"number","minimum":0},"min_swing_candidate_net_displacement_px":{"type":"number","minimum":0},"note":{"type":"string"}}},
  "keyframes":{"type":"array","minItems":2,"items":{"type":"object","additionalProperties":false,"required":["source_frame_id","landmarks"],"properties":{"source_frame_id":{"type":"integer","minimum":0},"landmarks":{"type":"object","minProperties":1,"additionalProperties":{"$ref":"#/$defs/point"}}}}}
 },
 "$defs":{"color":{"type":"string","pattern":"^#[A-Fa-f0-9]{6}$"},"point":{"type":"object","additionalProperties":false,"required":["x","y"],"properties":{"x":{"type":"number"},"y":{"type":"number"}}}}
}