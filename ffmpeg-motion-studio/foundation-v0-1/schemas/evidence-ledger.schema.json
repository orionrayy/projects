{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orionrayy.github.io/projects/ffmpeg-motion-studio/foundation-v0-1/schemas/evidence-ledger.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ledger_schema_version",
    "project",
    "policy",
    "records"
  ],
  "properties": {
    "ledger_schema_version": {
      "const": "1.0.0"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "data_ingestion_claims_require",
        "training_claims_require"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "data_ingestion_claims_require": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "training_claims_require": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "claim",
          "verification_method",
          "evidence",
          "limitation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]+$"
          },
          "status": {
            "enum": [
              "verified_by_source_inspection",
              "pending_ci",
              "not_performed",
              "passed_ci",
              "failed_ci"
            ]
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "verification_method": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "symbol"
              ],
              "properties": {
                "revision": {
                  "type": "string",
                  "minLength": 7
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "symbol": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          },
          "limitation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
